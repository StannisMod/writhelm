{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writhelm:core-codec:v1",
  "title": "Writhelm core codec v1 field shapes",
  "$comment": "Shape oracle only. Token spelling, UTF-8, surrogate validity, budgets, canonical order, duplicate decoded members and domain/graph laws require the strict codec. No remote references.",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/record"},
    {"$ref": "#/$defs/command"}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "offset": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "clauseId": {"type": "string", "minLength": 1},
    "header": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "modelVersion"],
      "properties": {"formatVersion": {"const": 1}, "modelVersion": {"const": 1}}
    },
    "documentKey": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "documentId"],
      "properties": {"projectId": {"$ref": "#/$defs/uuid"}, "documentId": {"$ref": "#/$defs/uuid"}}
    },
    "revisionKey": {
      "type": "object", "additionalProperties": false, "required": ["document", "revisionId"],
      "properties": {"document": {"$ref": "#/$defs/documentKey"}, "revisionId": {"$ref": "#/$defs/uuid"}}
    },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["document", "clauseId"],
      "properties": {"document": {"$ref": "#/$defs/documentKey"}, "clauseId": {"oneOf": [{"$ref": "#/$defs/clauseId"}, {"type": "null"}]}}
    },
    "clauseReference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "revision", "revisionDigest", "clauseId", "contentDigest"],
      "properties": {
        "kind": {"const": "clause"}, "revision": {"$ref": "#/$defs/revisionKey"},
        "revisionDigest": {"$ref": "#/$defs/digest"}, "clauseId": {"$ref": "#/$defs/clauseId"},
        "contentDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "contextReference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "revision", "revisionDigest", "contextDigest"],
      "properties": {
        "kind": {"const": "context"}, "revision": {"$ref": "#/$defs/revisionKey"},
        "revisionDigest": {"$ref": "#/$defs/digest"}, "contextDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "reference": {"oneOf": [{"$ref": "#/$defs/clauseReference"}, {"$ref": "#/$defs/contextReference"}]},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "contexts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contextReference"}},
    "clauses": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/clauseReference"}},
    "range": {
      "type": "object", "additionalProperties": false, "required": ["start", "endExclusive"],
      "properties": {"start": {"$ref": "#/$defs/offset"}, "endExclusive": {"$ref": "#/$defs/offset"}}
    },
    "clauseSpan": {
      "type": "object", "additionalProperties": false, "required": ["id", "span"],
      "properties": {"id": {"$ref": "#/$defs/clauseId"}, "span": {"$ref": "#/$defs/range"}}
    },
    "structure": {
      "type": "object", "additionalProperties": false, "required": ["clauses", "context"],
      "properties": {
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/clauseSpan"}},
        "context": {"type": "array", "items": {"$ref": "#/$defs/range"}}
      }
    },
    "reviewItem": {
      "type": "object", "additionalProperties": false, "required": ["id", "target", "before"],
      "properties": {"id": {"$ref": "#/$defs/uuid"}, "target": {"$ref": "#/$defs/reference"},
        "before": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]}}
    },
    "packet": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "question", "scope", "rationale", "consequences", "alternatives", "uncertainties", "contexts", "dependencies", "informationGaps"],
      "properties": {
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewItem"}},
        "question": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"},
        "consequences": {"allOf": [{"$ref": "#/$defs/texts"}, {"minItems": 1}]},
        "alternatives": {"allOf": [{"$ref": "#/$defs/texts"}, {"minItems": 1}]},
        "uncertainties": {"$ref": "#/$defs/texts"}, "contexts": {"$ref": "#/$defs/contexts"},
        "dependencies": {"$ref": "#/$defs/references"}, "informationGaps": {"$ref": "#/$defs/texts"}
      }
    },
    "comment": {
      "type": "object", "additionalProperties": false, "required": ["itemId", "text"],
      "properties": {"itemId": {"$ref": "#/$defs/uuid"}, "text": {"$ref": "#/$defs/text"}}
    },
    "answer": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["approve", "reject"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "comments"], "properties": {
          "kind": {"const": "changes-required"}, "comments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/comment"}}
        }}
      ]
    },
    "guard": {
      "type": "object", "additionalProperties": false, "required": ["subject", "generation"],
      "properties": {"subject": {"$ref": "#/$defs/subject"}, "generation": {"$ref": "#/$defs/generation"}}
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["source", "target"],
      "properties": {"source": {"$ref": "#/$defs/reference"}, "target": {"$ref": "#/$defs/reference"}}
    },
    "trace": {
      "type": "object", "additionalProperties": false, "required": ["origin", "requestId", "approvedBy", "assessmentIds"],
      "properties": {"origin": {"$ref": "#/$defs/reference"}, "requestId": {"$ref": "#/$defs/uuid"},
        "approvedBy": {"$ref": "#/$defs/uuid"}, "assessmentIds": {"type": "array", "items": {"$ref": "#/$defs/uuid"}}}
    },
    "provenanceEntry": {
      "type": "object", "additionalProperties": false, "required": ["reference", "trace"],
      "properties": {"reference": {"$ref": "#/$defs/reference"}, "trace": {"$ref": "#/$defs/trace"}}
    },
    "grantKey": {
      "type": "object", "additionalProperties": false, "required": ["principalId", "projectId"],
      "properties": {"principalId": {"$ref": "#/$defs/uuid"}, "projectId": {"$ref": "#/$defs/uuid"}}
    },
    "revisionPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["bodyDigest", "bodyBytes", "structure", "structureDigest", "revisionDigest", "contextDigest"],
      "properties": {"bodyDigest": {"$ref": "#/$defs/digest"}, "bodyBytes": {"$ref": "#/$defs/offset"},
        "structure": {"$ref": "#/$defs/structure"}, "structureDigest": {"$ref": "#/$defs/digest"},
        "revisionDigest": {"$ref": "#/$defs/digest"}, "contextDigest": {"$ref": "#/$defs/digest"}}
    },
    "proposalPayload": {
      "type": "object", "additionalProperties": false, "required": ["principalId"],
      "properties": {"principalId": {"$ref": "#/$defs/uuid"}}
    },
    "grantPayload": {
      "type": "object", "additionalProperties": false, "required": ["capabilities"],
      "properties": {"capabilities": {"type": "array", "uniqueItems": true,
        "items": {"enum": ["READ", "PROPOSE", "PLAN", "APPROVE", "MANAGE"]}}}
    },
    "requestPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "proposedBy", "packet", "generations", "packetDigest", "requestDigest"],
      "properties": {"projectId": {"$ref": "#/$defs/uuid"}, "proposedBy": {"$ref": "#/$defs/uuid"},
        "packet": {"$ref": "#/$defs/packet"}, "generations": {"type": "array", "items": {"$ref": "#/$defs/guard"}},
        "packetDigest": {"$ref": "#/$defs/digest"}, "requestDigest": {"$ref": "#/$defs/digest"}}
    },
    "resolutionPayload": {
      "type": "object", "additionalProperties": false, "required": ["actorId", "answer", "approved"],
      "properties": {"actorId": {"$ref": "#/$defs/uuid"}, "answer": {"$ref": "#/$defs/answer"},
        "approved": {"$ref": "#/$defs/references"}}
    },
    "continuityPayload": {
      "type": "object", "additionalProperties": false, "required": ["source", "assessmentId"],
      "properties": {"source": {"$ref": "#/$defs/reference"}, "assessmentId": {"$ref": "#/$defs/uuid"}}
    },
    "assessmentPayload": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "actorId", "references", "rationale", "links", "blocked"],
      "properties": {"projectId": {"$ref": "#/$defs/uuid"}, "actorId": {"$ref": "#/$defs/uuid"},
        "references": {"$ref": "#/$defs/references"}, "rationale": {"$ref": "#/$defs/text"},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}, "blocked": {"$ref": "#/$defs/references"}}
    },
    "manifestPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["consumerId", "projectId", "createdBy", "clauses", "contexts", "dependencies", "assessmentId", "provenance"],
      "properties": {"consumerId": {"$ref": "#/$defs/uuid"}, "projectId": {"$ref": "#/$defs/uuid"},
        "createdBy": {"$ref": "#/$defs/uuid"}, "clauses": {"allOf": [{"$ref": "#/$defs/clauses"}, {"minItems": 1}]},
        "contexts": {"$ref": "#/$defs/contexts"}, "dependencies": {"$ref": "#/$defs/references"},
        "assessmentId": {"$ref": "#/$defs/uuid"}, "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenanceEntry"}}}
    },
    "headPayload": {
      "type": "object", "additionalProperties": false, "required": ["reference"],
      "properties": {"reference": {"$ref": "#/$defs/reference"}}
    },
    "generationPayload": {
      "type": "object", "additionalProperties": false, "required": ["generation"],
      "properties": {"generation": {"$ref": "#/$defs/generation"}}
    },
    "emptyPayload": {"type": "object", "additionalProperties": false, "maxProperties": 0},
    "record": {
      "type": "object", "additionalProperties": false, "required": ["formatVersion", "family", "key", "payload"],
      "properties": {"formatVersion": {"const": 1}, "family": {"type": "string"}, "key": {}, "payload": {}},
      "oneOf": [
        {"properties": {"family": {"const": "revisions"}, "key": {"$ref": "#/$defs/revisionKey"}, "payload": {"$ref": "#/$defs/revisionPayload"}}},
        {"properties": {"family": {"const": "proposals"}, "key": {"$ref": "#/$defs/revisionKey"}, "payload": {"$ref": "#/$defs/proposalPayload"}}},
        {"properties": {"family": {"const": "grants"}, "key": {"$ref": "#/$defs/grantKey"}, "payload": {"$ref": "#/$defs/grantPayload"}}},
        {"properties": {"family": {"const": "requests"}, "key": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/requestPayload"}}},
        {"properties": {"family": {"const": "resolutions"}, "key": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/resolutionPayload"}}},
        {"properties": {"family": {"const": "approvals"}, "key": {"$ref": "#/$defs/reference"}, "payload": {"$ref": "#/$defs/trace"}}},
        {"properties": {"family": {"const": "continuity"}, "key": {"$ref": "#/$defs/reference"}, "payload": {"$ref": "#/$defs/continuityPayload"}}},
        {"properties": {"family": {"const": "assessments"}, "key": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/assessmentPayload"}}},
        {"properties": {"family": {"const": "manifests"}, "key": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/manifestPayload"}}},
        {"properties": {"family": {"const": "heads"}, "key": {"$ref": "#/$defs/subject"}, "payload": {"$ref": "#/$defs/headPayload"}}},
        {"properties": {"family": {"const": "generations"}, "key": {"$ref": "#/$defs/subject"}, "payload": {"$ref": "#/$defs/generationPayload"}}},
        {"properties": {"family": {"const": "blocked"}, "key": {"$ref": "#/$defs/reference"}, "payload": {"$ref": "#/$defs/emptyPayload"}}}
      ]
    },
    "proposePayload": {
      "type": "object", "additionalProperties": false, "required": ["revisionKey", "body", "structure"],
      "properties": {"revisionKey": {"$ref": "#/$defs/revisionKey"}, "body": {"type": "string"}, "structure": {"$ref": "#/$defs/structure"}}
    },
    "newRequestPayload": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "packet"],
      "properties": {"requestId": {"$ref": "#/$defs/uuid"}, "packet": {"$ref": "#/$defs/packet"}}
    },
    "resolvePayload": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "requestDigest", "packetDigest", "answer"],
      "properties": {"requestId": {"$ref": "#/$defs/uuid"}, "requestDigest": {"$ref": "#/$defs/digest"},
        "packetDigest": {"$ref": "#/$defs/digest"}, "answer": {"$ref": "#/$defs/answer"}}
    },
    "newAssessmentPayload": {
      "type": "object", "additionalProperties": false, "required": ["assessmentId", "references", "rationale", "links", "blocked"],
      "properties": {"assessmentId": {"$ref": "#/$defs/uuid"}, "references": {"$ref": "#/$defs/references"},
        "rationale": {"$ref": "#/$defs/text"}, "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "blocked": {"$ref": "#/$defs/references"}}
    },
    "pinPayload": {
      "type": "object", "additionalProperties": false, "required": ["manifestId", "consumerId", "clauses", "contexts", "dependencies", "assessmentId"],
      "properties": {"manifestId": {"$ref": "#/$defs/uuid"}, "consumerId": {"$ref": "#/$defs/uuid"},
        "clauses": {"allOf": [{"$ref": "#/$defs/clauses"}, {"minItems": 1}]}, "contexts": {"$ref": "#/$defs/contexts"},
        "dependencies": {"$ref": "#/$defs/references"}, "assessmentId": {"$ref": "#/$defs/uuid"}}
    },
    "revokePayload": {
      "type": "object", "additionalProperties": false, "required": ["principalId"],
      "properties": {"principalId": {"$ref": "#/$defs/uuid"}}
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["formatVersion", "requestKey", "projectId", "operation", "payload"],
      "properties": {"formatVersion": {"const": 1}, "requestKey": {"$ref": "#/$defs/uuid"},
        "projectId": {"$ref": "#/$defs/uuid"}, "operation": {"type": "string"}, "payload": {}},
      "oneOf": [
        {"properties": {"operation": {"const": "propose_revision"}, "payload": {"$ref": "#/$defs/proposePayload"}}},
        {"properties": {"operation": {"const": "request_approval"}, "payload": {"$ref": "#/$defs/newRequestPayload"}}},
        {"properties": {"operation": {"const": "resolve_approval"}, "payload": {"$ref": "#/$defs/resolvePayload"}}},
        {"properties": {"operation": {"const": "record_assessment"}, "payload": {"$ref": "#/$defs/newAssessmentPayload"}}},
        {"properties": {"operation": {"const": "pin_consumer"}, "payload": {"$ref": "#/$defs/pinPayload"}}},
        {"properties": {"operation": {"const": "revoke_access"}, "payload": {"$ref": "#/$defs/revokePayload"}}}
      ]
    }
  }
}
