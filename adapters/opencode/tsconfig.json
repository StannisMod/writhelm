{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true, "allowJs": true,
    "outDir": "build", "rootDir": ".", "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/generated/*.cjs", "tests/**/*.ts"]
}
